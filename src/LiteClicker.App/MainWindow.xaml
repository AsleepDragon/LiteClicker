<Window x:Class="LiteClicker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:LiteClicker.App.ViewModels" Title="轻点连点器 LiteClicker" Width="520" Height="620" MinWidth="440" MinHeight="540" Icon="Assets/LiteClicker.ico" WindowStartupLocation="Manual">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="轻点连点器" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="LiteClicker · 让重复操作轻一点" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Column="1" CornerRadius="7" Background="#E8EEF8" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="1.0" Foreground="#425A7A" FontSize="12"/></Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Background="#FFF8E8" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="×" Width="32" Padding="2" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="关闭提示" Margin="8,0,0,0"/><TextBlock Text="{Binding Notice}" Foreground="#785600" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,10,0"/><TextBlock Text="{Binding StateTitle}" Foreground="{Binding StateColor}" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="22" FontFamily="Consolas" Foreground="{StaticResource Ink}" VerticalAlignment="Center" AutomationProperties.Name="本次运行时间"/>
            </Grid>
            <TextBlock Text="{Binding StateDescription}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="操作模式" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <RadioButton Content="连续点击" GroupName="Mode" Style="{StaticResource ModeOption}" IsChecked="{Binding IsClickMode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="连续点击模式"/>
            <RadioButton Grid.Column="2" Content="持续按住" GroupName="Mode" Style="{StaticResource ModeOption}" IsChecked="{Binding IsHoldMode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="持续按住模式"/>
          </Grid>
          <TextBlock Text="按住模式不使用点击频率。避免同时操作物理左键。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding ShowHoldHint, Converter={StaticResource BoolVisibility}}"/>
          <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanEditSpeed}">
            <TextBlock Text="点击速度" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="5">
              <Button Command="{Binding PresetCommand}" CommandParameter="1" AutomationProperties.Name="1 档，每秒 1 次"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Preset}"><Style.Triggers><DataTrigger Binding="{Binding SpeedSelection}" Value="preset1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="1 档" HorizontalAlignment="Center"/><TextBlock Text="1 次/秒" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Command="{Binding PresetCommand}" CommandParameter="2" AutomationProperties.Name="2 档，每秒 5 次"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Preset}"><Style.Triggers><DataTrigger Binding="{Binding SpeedSelection}" Value="preset2"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="2 档" HorizontalAlignment="Center"/><TextBlock Text="5 次/秒" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Command="{Binding PresetCommand}" CommandParameter="3" AutomationProperties.Name="3 档，每秒 10 次"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Preset}"><Style.Triggers><DataTrigger Binding="{Binding SpeedSelection}" Value="preset3"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="3 档" HorizontalAlignment="Center"/><TextBlock Text="10 次/秒" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Command="{Binding PresetCommand}" CommandParameter="4" AutomationProperties.Name="4 档，每秒 20 次"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Preset}"><Style.Triggers><DataTrigger Binding="{Binding SpeedSelection}" Value="preset4"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="4 档" HorizontalAlignment="Center"/><TextBlock Text="20 次/秒" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Command="{Binding PresetCommand}" CommandParameter="5" AutomationProperties.Name="5 档，每秒 50 次"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Preset}"><Style.Triggers><DataTrigger Binding="{Binding SpeedSelection}" Value="preset5"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="5 档" HorizontalAlignment="Center"/><TextBlock Text="50 次/秒" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
            </UniformGrid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="自定义" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox Grid.Column="1" Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="SpeedLostFocus" MaxLength="12" AutomationProperties.Name="每秒点击次数，1 到 100 的整数"/>
              <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="次 / 秒" FontSize="12"/><TextBlock Text="{Binding Interval}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            </Grid>
            <TextBlock Text="{Binding SpeedError}" Foreground="#B42318" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasSpeedError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="启动延迟" FontWeight="SemiBold"/><TextBlock Text="预留移动鼠标的时间" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Delays}" SelectedItem="{Binding Delay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="启动延迟秒数"/>
            <TextBlock Grid.Column="2" Text="秒" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><Expander>
          <Expander.Header><StackPanel><TextBlock Text="全局快捷键" FontWeight="SemiBold"/><TextBlock Text="{Binding HotkeySummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Expander.Header>
          <StackPanel Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding HotkeyRows}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:HotkeyEditorRow.Keys}" SelectedItem="{Binding Key}" AutomationProperties.Name="{Binding Name}"/>
                <WrapPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"><CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" Margin="0,0,8,0"/><CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,8,0"/><CheckBox Content="Shift" IsChecked="{Binding Shift}"/></WrapPanel>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding HotkeyError}" Foreground="#B42318" FontSize="12" Margin="0,0,0,8" Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolVisibility}}"/>
            <WrapPanel><Button Content="应用快捷键" Command="{Binding ApplyHotkeysCommand}" Margin="0,0,8,0"/><Button Content="恢复默认" Command="{Binding ResetHotkeysCommand}"/></WrapPanel>
            <TextBlock Text="支持 F1–F11，可组合 Ctrl / Alt / Shift。修改成功后自动保存。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Expander></Border>
        <Expander Header="使用说明与权限" Margin="2,0,0,12" FontSize="12"><TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="最小化后进入托盘，已开始的动作继续；关闭窗口会停止并退出。&#x0a;&#x0a;目标以管理员权限运行时，可手动以相同权限打开本工具。程序不会自动提权。锁屏、UAC 安全桌面和受保护窗口不支持；游戏、独占全屏与远程桌面不保证兼容。&#x0a;&#x0a;“已发送”表示完整输入对已提交给系统，不保证目标程序接受。强制结束进程、崩溃或断电时无法保证补发抬起。"/></Expander>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold" MinHeight="42"/>
        <Button Grid.Column="2" Content="停止所有动作" Command="{Binding StopCommand}" Foreground="#B42318" BorderBrush="#E4B4AE" Background="#FFF7F6" FontWeight="SemiBold" MinHeight="42"/>
      </Grid>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="作用于当前鼠标位置" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding EmergencyLabel}" Foreground="#B42318" FontWeight="SemiBold" FontSize="12"/></Grid>
    </StackPanel>
  </Grid>
</Window>
